{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DataSets-Manager",
  "version": "0.1.0",
  "identifier": "dev.bhuzgujj.datasets-manager",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/datasets-manager/browser"
  },
  "app": {
    "windows": [
      {
        "title": "DataSets-Manager",
        "width": 1600,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": null,
      "wix": {
        "fragmentPaths": [
          "./wix/cli.wxs"
        ],
        "componentRefs": [
          "DsmCliComponent"
        ]
      }
    }
  }
}
